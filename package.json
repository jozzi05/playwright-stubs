{
  "name": "playwright-stubs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prototype: Jest/Cypress-style module export stubbing for Playwright component tests, via import-site instrumentation and a browser-side stub registry.",
  "scripts": {
    "test": "npm run test:transform && npm run test:ct",
    "test:transform": "vitest run",
    "test:ct": "playwright test -c playwright-ct.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "acorn": "^8.0.0",
    "magic-string": "^0.30.0"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "latest",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
