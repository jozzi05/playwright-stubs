{
  "name": "playwright-stubs",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Jest/Vitest-style module export mocking for Playwright component tests in a real browser.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jozzi05/playwright-stubs.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./vite-plugin": {
      "types": "./dist/vite-plugin/index.d.ts",
      "import": "./dist/vite-plugin/index.js"
    },
    "./fixture": {
      "types": "./dist/playwright/fixture.d.ts",
      "import": "./dist/playwright/fixture.js"
    },
    "./assertions": {
      "types": "./dist/playwright/assertions.d.ts",
      "import": "./dist/playwright/assertions.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build && npm test",
    "test": "npm run test:transform && npm run test:ct",
    "test:transform": "vitest run",
    "test:ct": "playwright test -c playwright-ct.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "acorn": "^8.0.0",
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "@playwright/test": "^1.40.0",
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "latest",
    "@playwright/test": "^1.62.1",
    "@types/classnames": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
